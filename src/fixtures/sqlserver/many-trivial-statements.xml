<?xml version="1.0" encoding="utf-8"?>
<!-- Story 20.1 — a batch mixing real-query statements with a run of
     trivial (cost-0, no-finding) control-flow statements, the shape a
     large stored procedure produces. Regression fixture for the statement
     tab strip's collapse-a-trivial-run behavior. -->
<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.5" Build="16.0.1000.6">
  <BatchSequence>
    <Batch>
      <Statements>
        <StmtSimple StatementText="SELECT * FROM Orders" StatementId="1" StatementCompId="1">
          <QueryPlan>
            <RelOp NodeId="0" PhysicalOp="Table Scan" LogicalOp="Table Scan" EstimateRows="100" EstimatedTotalSubtreeCost="0.5">
              <TableScan>
                <Object Database="[MyDb]" Schema="[dbo]" Table="[Orders]" />
              </TableScan>
            </RelOp>
          </QueryPlan>
        </StmtSimple>
        <StmtSimple StatementText="DECLARE @x INT" StatementId="2" StatementCompId="1">
          <QueryPlan>
            <RelOp NodeId="0" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="1" EstimatedTotalSubtreeCost="0">
              <ComputeScalar><DefinedValues/></ComputeScalar>
            </RelOp>
          </QueryPlan>
        </StmtSimple>
        <StmtSimple StatementText="IF EXISTS (SELECT 1 FROM Foo)" StatementId="3" StatementCompId="1">
          <QueryPlan>
            <RelOp NodeId="0" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="1" EstimatedTotalSubtreeCost="0">
              <ComputeScalar><DefinedValues/></ComputeScalar>
            </RelOp>
          </QueryPlan>
        </StmtSimple>
        <StmtSimple StatementText="SET @x = 1" StatementId="4" StatementCompId="1">
          <QueryPlan>
            <RelOp NodeId="0" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="1" EstimatedTotalSubtreeCost="0">
              <ComputeScalar><DefinedValues/></ComputeScalar>
            </RelOp>
          </QueryPlan>
        </StmtSimple>
        <StmtSimple StatementText="SELECT * FROM Customers" StatementId="5" StatementCompId="1">
          <QueryPlan>
            <RelOp NodeId="0" PhysicalOp="Clustered Index Scan" LogicalOp="Clustered Index Scan" EstimateRows="800" EstimatedTotalSubtreeCost="1.5">
              <IndexScan>
                <Object Database="[MyDb]" Schema="[dbo]" Table="[Customers]" Index="[PK_Customers]" />
              </IndexScan>
            </RelOp>
          </QueryPlan>
        </StmtSimple>
      </Statements>
    </Batch>
  </BatchSequence>
</ShowPlanXML>
